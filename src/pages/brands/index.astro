---
/**
 * Brand index. Four manufacturer hubs, each a filtered view of the verified
 * specification table rather than a review section.
 */
import Base from '../../layouts/Base.astro';
import db from '../../data/power-stations.json';
import { BRANDS, isCurrent } from '../../lib/catalog.ts';

const current = db.stations.filter(isCurrent);

const cards = BRANDS.map((brand) => {
  const models = current.filter((s) => s.brand === brand.name);
  const boostOnly = models.filter((s) => s.peak_is_surge === false).length;
  return {
    ...brand,
    count: models.length,
    boostOnly,
    href: `/brands/${brand.slug}/`,
  };
});
---

<Base
  title="Power station brands"
  description="EcoFlow, Jackery, BLUETTI, and Anker SOLIX specifications from manufacturer pages, grouped by brand. Surge and boost ratings are labelled separately."
>
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">Brands</h1>
    <p class="mt-4 max-w-[68ch] text-lg leading-7 text-ink-600 dark:text-ink-300">
      Each hub is the verified table filtered to one manufacturer. The numbers come from the same
      records as the
      <a href="/stations/" class="text-moss-700 underline dark:text-moss-300">station pages</a>
      and the calculator. Nothing here is a review, and a peak marked as boost is not treated as a
      motor-start rating.
    </p>

    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        cards.map((card) => (
          <li>
            <a
              href={card.href}
              class="press flex min-h-32 items-center justify-between gap-4 rounded-[var(--radius-card)] border border-ink-200 bg-white p-5 hover:border-moss-500 dark:border-ink-800 dark:bg-ink-900"
            >
              <span>
                <span class="block text-lg font-semibold">{card.name}</span>
                <span class="mt-1 block text-sm text-ink-500 dark:text-ink-400">
                  {card.count} current model{card.count === 1 ? '' : 's'}
                  {card.boostOnly
                    ? ` · ${card.boostOnly} with a boost rating instead of inverter surge`
                    : ''}
                </span>
              </span>
              <span class="text-sm font-medium text-moss-700 dark:text-moss-300">Open table</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="mt-10 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
      To see whether a model starts a fridge compressor, open the refrigerator page on any station
      record. Those pages use the same surge check as the calculator, including the boost
      distinction.
    </p>
  </section>
</Base>
