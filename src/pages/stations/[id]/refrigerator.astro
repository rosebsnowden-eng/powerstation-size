---
/**
 * Per-station refrigerator verdict.
 *
 * One URL per verified record. The fridge wattage is an estimated engineering
 * range from the device library, not a measurement of a specific refrigerator.
 * The station figures are the manufacturer specs. runtimeFor() is the same
 * function the calculator uses, so this page cannot drift from the tool.
 *
 * Boost ratings (peak_is_surge === false) do not clear a compressor start.
 */
import Base from '../../../layouts/Base.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import VerifiedStamp from '../../../components/VerifiedStamp.astro';
import db from '../../../data/power-stations.json';
import { site } from '../../../data/site.ts';
import { boostNotCheckedCopy, brandSlug, fridgeHomeLoad, fridgeQuery, toStationSpec } from '../../../lib/catalog.ts';
import { runtimeFor, USABLE_CAPACITY_FACTOR } from '../../../lib/calculate.ts';

export function getStaticPaths() {
  return db.stations.map((station) => ({
    params: { id: station.id },
    props: { station },
  }));
}

const { station } = Astro.props;
const load = fridgeHomeLoad();
const fridge = load[0];
const spec = toStationSpec(station);
const runtime = runtimeFor(spec, load);
const constraint = runtime.bindingConstraint;
const hours = (n: number) => `${n.toFixed(1)} h`;
const n = (value: number) => value.toLocaleString('en-US');
const usableWh = Math.round(station.capacity_wh * USABLE_CAPACITY_FACTOR);
const averageDrawW = fridge.watts * fridge.dutyCycle;
const brand = brandSlug(station.brand);

const calculatorHref =
  `/calculator/#calculator?load=${encodeURIComponent(fridgeQuery(load))}` + `&station=${station.id}`;

const origin = Astro.site ?? 'https://example.com';

const headline =
  constraint === null
    ? `${station.brand} ${station.model} can start this fridge load on paper`
    : constraint === 'surge_unverified'
      ? `${station.brand} ${station.model} does not publish an inverter surge, so this fridge start is not cleared`
      : constraint === 'surge'
        ? `${station.brand} ${station.model} cannot start this fridge compressor`
        : constraint === 'continuous'
          ? `${station.brand} ${station.model} cannot hold this fridge running wattage`
          : `${station.brand} ${station.model} does not have the capacity for this fridge load`;

const description =
  constraint === null
    ? `Against a 150 W fridge at 35 percent duty and 1,200 W startup, the ${station.model} clears continuous output and surge. Estimated cycling runtime is about ${hours(runtime.averageHours)}.`
    : `Against a 150 W fridge at 35 percent duty and 1,200 W startup, the ${station.model} fails on ${constraint.replaceAll('_', ' ')}. Station specs from the manufacturer page, verified ${station.verified_at}.`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline,
  description,
  url: new URL(`/stations/${station.id}/refrigerator/`, origin).href,
  publisher: { '@type': 'Organization', name: site.name },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Stations', item: new URL('/stations/', origin).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: `${station.brand} ${station.model}`,
      item: new URL(`/stations/${station.id}/`, origin).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Refrigerator',
      item: new URL(`/stations/${station.id}/refrigerator/`, origin).href,
    },
  ],
};

const related = db.stations
  .filter((s) => s.brand === station.brand && s.id !== station.id)
  .slice(0, 4);
---

<Base title={headline} description={description} canonicalPath={`/stations/${station.id}/refrigerator/`}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="mx-auto max-w-3xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-500 dark:text-ink-400">
      <a href="/stations/" class="underline hover:text-moss-700 dark:hover:text-moss-300">Stations</a>
      <span aria-hidden="true"> / </span>
      <a href={`/stations/${station.id}/`} class="underline hover:text-moss-700 dark:hover:text-moss-300">
        {station.brand} {station.model}
      </a>
      <span aria-hidden="true"> / </span>
      <span>Refrigerator</span>
    </nav>

    <h1 class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">
      Can the {station.brand} {station.model} run a refrigerator?
    </h1>
    <p class="mt-4 max-w-[68ch] text-ink-600 dark:text-ink-300">{headline}.</p>
    <p class="mt-3 max-w-[68ch] text-sm text-ink-500 dark:text-ink-400">
      The fridge numbers are an estimated engineering range from the device library, not a
      measurement of your compressor.
    </p>
    <VerifiedStamp verifiedAt={station.verified_at} sourceUrl={station.source_url} />

    <section class="mt-10 rounded-[var(--radius-card)] border border-ink-200 bg-white p-5 dark:border-ink-800 dark:bg-ink-900">
      <h2 class="text-lg font-semibold tracking-tight">The check</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500 dark:text-ink-400">
            Binding limit
          </dt>
          <dd class="mt-1 text-xl font-semibold">
            {constraint === null
              ? 'None. Startup and running draw both clear.'
              : constraint === 'surge_unverified'
                ? 'Unverified boost'
                : constraint === 'surge'
                  ? 'Startup surge'
                  : constraint === 'continuous'
                    ? 'Continuous output'
                    : 'Capacity'}
          </dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500 dark:text-ink-400">
            Estimated cycling runtime
          </dt>
          <dd class="tabular mt-1 text-xl font-semibold">
            {constraint === 'surge' || constraint === 'surge_unverified' || constraint === 'continuous'
              ? 'Not applicable until it can start and run'
              : hours(runtime.averageHours)}
          </dd>
          <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
            Usable capacity {n(usableWh)} Wh at {Math.round(USABLE_CAPACITY_FACTOR * 100)} percent of
            nameplate, divided by {averageDrawW} W average draw.
          </p>
        </div>
      </dl>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight">What was compared</h2>
      <div class="mt-4 overflow-x-auto rounded-[var(--radius-card)] border border-ink-200 dark:border-ink-800">
        <table class="w-full border-collapse bg-white text-left text-sm dark:bg-ink-900">
          <caption class="sr-only">Fridge load versus this station</caption>
          <thead>
            <tr class="border-b border-ink-200 dark:border-ink-800">
              <th scope="col" class="px-4 py-3 font-semibold">Check</th>
              <th scope="col" class="px-4 py-3 font-semibold">This fridge load</th>
              <th scope="col" class="px-4 py-3 font-semibold">This station</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-ink-100 dark:border-ink-800/60">
              <th scope="row" class="px-4 py-3 font-medium">Running watts</th>
              <td class="tabular px-4 py-3">{fridge.watts} W nameplate</td>
              <td class="tabular px-4 py-3">{n(station.output_continuous_w)} W continuous</td>
            </tr>
            <tr class="border-b border-ink-100 dark:border-ink-800/60">
              <th scope="row" class="px-4 py-3 font-medium">Startup</th>
              <td class="tabular px-4 py-3">{n(fridge.surgeWatts ?? 0)} W estimated inrush</td>
              <td class="tabular px-4 py-3">
                {n(station.output_peak_w)} W
                {station.peak_is_surge === false ? ' boost, not inverter surge' : ' inverter surge'}
              </td>
            </tr>
            <tr>
              <th scope="row" class="px-4 py-3 font-medium">Energy</th>
              <td class="tabular px-4 py-3">
                {Math.round(fridge.watts * fridge.hours * fridge.dutyCycle)} Wh over {fridge.hours} h
                at {Math.round(fridge.dutyCycle * 100)} percent duty
              </td>
              <td class="tabular px-4 py-3">{n(station.capacity_wh)} Wh nameplate</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight">What that means</h2>
      {
        constraint === 'surge_unverified' ? (
          <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
            {boostNotCheckedCopy(station)} Continuous output ({n(station.output_continuous_w)} W) is
            enough for the 150 W running draw, and capacity is a separate question once a motor
            start is actually verified. See
            <a href="/guides/surge-vs-boost/" class="text-moss-700 underline dark:text-moss-300">surge versus boost</a>.
          </p>
        ) : constraint === 'surge' ? (
          <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
            The published inverter surge is {n(station.output_peak_w)} W, below the 1,200 W startup
            used here. Capacity does not matter until the compressor can start. A smaller fridge, or
            a station with a higher inverter surge, changes this answer. A larger battery with the
            same inverter does not.
          </p>
        ) : constraint === 'continuous' ? (
          <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
            Continuous output is {n(station.output_continuous_w)} W, below the 150 W running draw
            used here. That is unusual for a full-size station and usually means this unit is sized
            for lights and charging, not kitchen loads.
          </p>
        ) : (
          <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
            On this estimated load the compressor can start and the cycling draw fits in the
            inverter. Worst case, if the compressor never cycled off, runtime would be closer to
            {hours(runtime.worstCaseHours)}. Real fridges vary by size, ambient temperature, and how
            often the door opens, so treat the hours as a planning range.
          </p>
        )
      }
    </section>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={calculatorHref}
        class="press inline-block rounded-[var(--radius-control)] bg-moss-700 px-5 py-3 text-sm font-semibold text-white hover:bg-moss-600"
      >
        Open this fridge load in the calculator
      </a>
      <a
        href={`/stations/${station.id}/`}
        class="press inline-block rounded-[var(--radius-control)] border border-ink-200 px-5 py-3 text-sm font-medium hover:border-moss-500 dark:border-ink-700"
      >
        Full specs
      </a>
      {
        brand ? (
          <a
            href={`/brands/${brand}/`}
            class="press inline-block rounded-[var(--radius-control)] border border-ink-200 px-5 py-3 text-sm font-medium hover:border-moss-500 dark:border-ink-700"
          >
            Other {station.brand} models
          </a>
        ) : null
      }
    </div>

    {
      related.length > 0 ? (
        <section class="mt-12">
          <h2 class="text-xl font-semibold tracking-tight">Other {station.brand} refrigerator pages</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {related.map((s) => (
              <li>
                <a
                  href={`/stations/${s.id}/refrigerator/`}
                  class="flex items-center gap-3 rounded-[var(--radius-control)] border border-ink-200 p-3 hover:border-moss-500 dark:border-ink-800"
                >
                  <img
                    src={`/images/stations/${s.id}.webp`}
                    alt=""
                    width="64"
                    height="48"
                    class="h-12 w-16 object-contain"
                  />
                  <span>
                    <span class="block text-sm font-semibold">{s.model}</span>
                    <span class="tabular text-xs text-ink-500">
                      {s.capacity_wh.toLocaleString('en-US')} Wh · {s.output_continuous_w} W
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }

    <div class="mt-10">
      <Disclaimer electrical />
    </div>
  </article>
</Base>
