---
/**
 * Scenario detail.
 *
 * Every number on this page is computed at build time by the same library the
 * live calculator imports (src/lib/calculate.ts). Nothing here is transcribed
 * by hand, so the static page cannot drift from the tool: the "open in the
 * calculator" link carries the identical load and reproduces these figures.
 *
 * Structured data is Article plus BreadcrumbList. docs/05-content-and-seo.md
 * reserves FAQPage for the calculator page and excludes Review and
 * MedicalDevice markup everywhere.
 */
import Base from '../../layouts/Base.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import db from '../../data/power-stations.json';
import { site } from '../../data/site.ts';
import { scenarios, analyzeScenario, scenarioQuery, getScenario } from '../../data/scenarios.ts';

export function getStaticPaths() {
  return scenarios.map((scenario) => ({
    params: { id: scenario.id },
    props: { scenario },
  }));
}

const { scenario } = Astro.props;
const current = getScenario(scenario.id) ?? scenario;

const catalog = db.stations
  .filter((s) => s.availability !== 'discontinued')
  .map((s) => ({
    id: s.id,
    brand: s.brand,
    model: s.model,
    capacity_wh: s.capacity_wh,
    output_continuous_w: s.output_continuous_w,
    output_peak_w: s.output_peak_w,
    peak_is_surge: s.peak_is_surge !== false,
    solar_input_max_w: (s.solar_input_max_w ?? null) as number | null,
    availability: s.availability,
  }));

const analysis = analyzeScenario(current, catalog);
const { rows, sizing, plan, match, limit } = analysis;

const n = (value: number) => Math.round(value).toLocaleString('en-US');
const best = match.eligible[0];
const runnersUp = match.eligible.slice(1, 5);

const calculatorHref =
  `/calculator/#calculator?load=${encodeURIComponent(scenarioQuery(current))}` +
  `&days=${current.backupDays}&sun=${current.sunHours}` +
  (best ? `&station=${best.station.id}` : '');

const loadRows = rows.map((row, i) => ({
  ...row,
  why: current.rows[i]?.why ?? '',
  dailyWh: row.watts * row.hours * row.dutyCycle,
}));

const limitCopy: Record<string, string> = {
  capacity: 'No model in the verified database holds enough usable capacity for this load.',
  continuous: 'No verified model can run every device in this load at the same time.',
  surge: 'The startup surge in this load exceeds the inverter surge of every verified model.',
  surge_unverified:
    'This load has a motor start, and no verified model publishes an inverter surge rating to check it against.',
  combination:
    'No single limit explains this one. The models with enough capacity do not have the output or the surge, and the ones with the output do not have the capacity, so this load needs two changes rather than one.',
};

const origin = Astro.site ?? 'https://example.com';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: current.title,
  description: current.lede,
  url: new URL(`/scenarios/${current.id}/`, origin).href,
  publisher: { '@type': 'Organization', name: site.name },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', origin).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Scenarios',
      item: new URL('/scenarios/', origin).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: current.title,
      item: new URL(`/scenarios/${current.id}/`, origin).href,
    },
  ],
};
---

<Base title={current.title} description={current.lede} canonicalPath={`/scenarios/${current.id}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <article class="mx-auto max-w-3xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-500 dark:text-ink-400">
      <a href="/scenarios/" class="underline hover:text-moss-700 dark:hover:text-moss-300">Scenarios</a>
      <span aria-hidden="true"> / </span>
      <span>{current.title}</span>
    </nav>

    <h1 class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">{current.title}</h1>
    <p class="mt-3 text-lg font-medium text-moss-700 dark:text-moss-300">{current.question}</p>
    <p class="mt-5 max-w-[68ch] text-ink-600 dark:text-ink-300">{current.lede}</p>

    <section class="mt-10 rounded-[var(--radius-card)] border border-ink-200 bg-white p-5 dark:border-ink-800 dark:bg-ink-900">
      <h2 class="text-lg font-semibold tracking-tight">The answer</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500 dark:text-ink-400">
            Battery to shop
          </dt>
          <dd class="tabular mt-1 text-2xl font-semibold">{n(plan.recommendedWh)} Wh</dd>
          <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
            Nameplate capacity, after inverter loss and a {Math.round((sizing.reserve - 1) * 100)} percent reserve,
            for {current.backupDays} day{current.backupDays === 1 ? '' : 's'}.
          </p>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500 dark:text-ink-400">
            Daily energy
          </dt>
          <dd class="tabular mt-1 text-2xl font-semibold">{n(sizing.rawDailyWh)} Wh</dd>
          <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
            {rows.length} device{rows.length === 1 ? '' : 's'} after duty cycle, before conversion losses.
          </p>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500 dark:text-ink-400">
            Startup surge
          </dt>
          <dd class="tabular mt-1 text-2xl font-semibold">
            {sizing.peakSurgeW ? `${n(sizing.peakSurgeW)} W` : 'Not modelled'}
          </dd>
          <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
            {sizing.peakSurgeW
              ? 'The highest single-device motor start in this load.'
              : 'No startup inrush value is entered. Check device and adapter specifications.'}
          </p>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500 dark:text-ink-400">
            All devices at once
          </dt>
          <dd class="tabular mt-1 text-2xl font-semibold">{n(sizing.simultaneousW)} W</dd>
          <p class="mt-1 text-xs text-ink-500 dark:text-ink-400">
            Continuous output the station has to hold if nothing is staggered.
          </p>
        </div>
      </dl>
      <p class="mt-5 max-w-[68ch] border-t border-ink-100 pt-4 text-sm text-ink-600 dark:border-ink-800 dark:text-ink-300">
        {current.insight}
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight">The load, row by row</h2>
      <div class="mt-4 overflow-x-auto rounded-[var(--radius-card)] border border-ink-200 dark:border-ink-800">
        <table class="w-full border-collapse bg-white text-left text-sm dark:bg-ink-900">
          <caption class="sr-only">Devices in this scenario with their wattage, hours, and duty cycle</caption>
          <thead>
            <tr class="border-b border-ink-200 dark:border-ink-800">
              <th scope="col" class="px-4 py-3 font-semibold">Device</th>
              <th scope="col" class="px-4 py-3 font-semibold">Watts</th>
              <th scope="col" class="px-4 py-3 font-semibold">Hours</th>
              <th scope="col" class="px-4 py-3 font-semibold">Duty</th>
              <th scope="col" class="px-4 py-3 font-semibold">Wh per day</th>
            </tr>
          </thead>
          <tbody>
            {
              loadRows.map((row) => (
                <tr class="border-b border-ink-100 last:border-0 dark:border-ink-800/60">
                  <th scope="row" class="px-4 py-3 font-medium">
                    <span class="block">{row.label}</span>
                    {row.why ? <span class="mt-0.5 block max-w-[42ch] text-xs font-normal text-ink-500 dark:text-ink-400">{row.why}</span> : null}
                  </th>
                  <td class="tabular px-4 py-3">{row.watts} W</td>
                  <td class="tabular px-4 py-3">{row.hours} h</td>
                  <td class="tabular px-4 py-3">{Math.round(row.dutyCycle * 100)}%</td>
                  <td class="tabular px-4 py-3">{n(row.dailyWh)} Wh</td>
                </tr>
              ))
            }
            <tr class="border-t border-ink-200 font-semibold dark:border-ink-800">
              <th scope="row" class="px-4 py-3">Total</th>
              <td class="px-4 py-3"></td>
              <td class="px-4 py-3"></td>
              <td class="px-4 py-3"></td>
              <td class="tabular px-4 py-3">{n(sizing.rawDailyWh)} Wh</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-2 max-w-[68ch] text-xs text-ink-500 dark:text-ink-400">
        Duty cycle is the share of each hour a device actually draws power. A compressor fridge cycles,
        so its average draw sits well below its nameplate.
      </p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight">What this load needs from a station</h2>
      <ul class="mt-4 space-y-2 text-sm text-ink-600 dark:text-ink-300">
        <li class="max-w-[68ch]">
          <strong class="text-ink-900 dark:text-ink-100">Capacity.</strong>
          At least {n(plan.recommendedWh)} Wh of nameplate capacity, which is {n(sizing.rawDailyWh)} Wh
          of daily draw divided by {Math.round(sizing.efficiency * 100)} percent inverter efficiency
          and multiplied by a {sizing.reserve} reserve.
        </li>
        <li class="max-w-[68ch]">
          <strong class="text-ink-900 dark:text-ink-100">Continuous output.</strong>
          At least {n(sizing.simultaneousW)} W if every device runs at once, or less if you stagger them.
        </li>
        <li class="max-w-[68ch]">
          <strong class="text-ink-900 dark:text-ink-100">Startup surge.</strong>
          {
            sizing.peakSurgeW
              ? `At least ${n(sizing.peakSurgeW)} W of inverter surge. A resistive boost rating does not clear a motor start, so stations publishing only that figure are excluded here.`
              : 'Startup inrush is not modelled for these rows. Check the device and adapter requirements; a missing surge value is not proof that no inrush occurs.'
          }
        </li>
        <li class="max-w-[68ch]">
          <strong class="text-ink-900 dark:text-ink-100">Solar, if you plan to recharge off grid.</strong>
          About {n(plan.solarNeededW)} W of panels to replace a day of draw in {current.sunHours} peak sun
          hours. Check the station's published solar input limit, because a larger array than it accepts
          is wasted.
        </li>
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight">
        {match.eligible.length
          ? `Verified models whose nameplate covers this estimated load (${match.eligible.length})`
          : 'No verified model covers this estimated load'}
      </h2>

      {
        match.eligible.length ? (
          <>
            <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
              Smallest nameplate that clears every calculated limit, first. These are not lab
              runtimes.
              {current.medical
                ? ' They are not therapy ratings. Confirm compatibility with your equipment provider.'
                : ' Confirm the figures on the manufacturer page before you buy.'}
            </p>
            <ul class="mt-4 space-y-2">
              {[best, ...runnersUp].filter(Boolean).map((entry, i) => (
                <li>
                  <a
                    href={`/stations/${entry.station.id}/`}
                    class="press flex items-center gap-4 rounded-[var(--radius-control)] border border-ink-200 p-3 hover:border-moss-500 dark:border-ink-800"
                  >
                    <img
                      src={`/images/stations/${entry.station.id}.webp`}
                      alt=""
                      width="64"
                      height="48"
                      class="h-12 w-16 shrink-0 object-contain"
                    />
                    <span class="min-w-0">
                      <span class="block text-sm font-semibold">
                        {entry.station.brand} {entry.station.model}
                        {i === 0 ? <span class="ml-2 text-xs font-semibold uppercase tracking-wide text-moss-700 dark:text-moss-300">Smallest that fits</span> : null}
                      </span>
                      <span class="tabular mt-0.5 block text-xs text-ink-500 dark:text-ink-400">
                        {n(entry.station.capacity_wh)} Wh / {n(entry.station.output_continuous_w)} W
                        {entry.station.peak_is_surge === false ? ' · boost only' : ` / ${n(entry.station.output_peak_w)} W surge`}
                        {' · '}{n(entry.spareWh)} Wh spare
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="mt-4 rounded-[var(--radius-card)] border border-ink-200 p-5 dark:border-ink-800">
            <p class="max-w-[68ch] text-sm text-ink-700 dark:text-ink-200">
              {limit ? limitCopy[limit] : limitCopy.capacity}
            </p>
            <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">{current.trim}</p>
          </div>
        )
      }

      {
        match.eligible.length > 0 && match.unverifiedBoost.length > 0 ? (
          <p class="mt-4 max-w-[68ch] text-xs text-ink-500 dark:text-ink-400">
            {match.unverifiedBoost.length} model{match.unverifiedBoost.length === 1 ? '' : 's'} in the
            database publish a resistive boost rating instead of an inverter surge, so they are not
            counted here
            {sizing.peakSurgeW ? ' against the motor start in this load' : ''}. Their capacity is still
            listed on their own pages.
          </p>
        ) : null
      }
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight">What to cut if nothing fits</h2>
      <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">{current.trim}</p>
    </section>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href={calculatorHref}
        class="press inline-block rounded-[var(--radius-control)] bg-moss-700 px-5 py-3 text-sm font-semibold text-white hover:bg-moss-600"
      >
        Open this load in the calculator
      </a>
      <a
        href="/scenarios/"
        class="press inline-block rounded-[var(--radius-control)] border border-ink-200 px-5 py-3 text-sm font-medium hover:border-moss-500 dark:border-ink-700"
      >
        Other scenarios
      </a>
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-semibold tracking-tight">Questions</h2>
      <div class="mt-4">
        {
          current.faq.map((item) => (
            <details class="border-b border-ink-200 py-4 dark:border-ink-800">
              <summary class="cursor-pointer text-base font-medium">{item.q}</summary>
              <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <div class="mt-10">
      <Disclaimer medical={current.medical} electrical={current.electrical} />
    </div>

    <p class="mt-8 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
      The formulas and constants behind every figure on this page are documented on the
      <a href="/methodology/" class="text-moss-700 underline dark:text-moss-300">methodology</a> page. Source
      URLs for the specifications sit on each
      <a href="/stations/" class="text-moss-700 underline dark:text-moss-300">model page</a>.
    </p>
  </article>
</Base>
