---
/**
 * Same-brand generation split. Neither peak is treated as inverter surge.
 */
import Base from '../../layouts/Base.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import db from '../../data/power-stations.json';
import { site } from '../../data/site.ts';
import { amazonUrlFor, isCurrent, toStationSpec } from '../../lib/catalog.ts';
import { getScenario, analyzeScenario, scenarioQuery } from '../../data/scenarios.ts';
import { runtimeFor } from '../../lib/calculate.ts';

const catalog = db.stations.filter(isCurrent);
const amazonTag = (db.meta as { amazon_tag?: string }).amazon_tag ?? '';
const left = catalog.find((s) => s.id === 'anker-solix-c1000');
const right = catalog.find((s) => s.id === 'anker-solix-c1000-gen2');
if (!left || !right) throw new Error('vs page missing C1000 or C1000 Gen 2');

const loads = [
  { id: 'cpap-overnight', label: 'CPAP night, humidifier off' },
  { id: 'cpap-night-humidifier', label: 'CPAP night, humidifier on' },
  { id: 'camping-day', label: 'Camping day (12V fridge)' },
  { id: 'fridge-outage', label: 'Home fridge outage' },
] as const;

function constraintLabel(constraint: string | null): string {
  if (constraint === 'surge') return 'Startup blocked';
  if (constraint === 'surge_unverified') return 'Boost only, not checked';
  if (constraint === 'continuous') return 'Continuous output short';
  if (constraint === 'capacity') return 'Capacity short';
  return 'Clears this load';
}

const rows = loads.map((load) => {
  const scenario = getScenario(load.id);
  if (!scenario) throw new Error(`missing scenario ${load.id}`);
  const analysis = analyzeScenario(scenario, catalog);
  const a = runtimeFor(toStationSpec(left), analysis.rows);
  const b = runtimeFor(toStationSpec(right), analysis.rows);
  return {
    ...load,
    needWh: analysis.plan.recommendedWh,
    surgeW: analysis.sizing.peakSurgeW,
    left: a,
    right: b,
    calcHref: `/calculator/#calculator?load=${encodeURIComponent(scenarioQuery(scenario))}&days=1`,
  };
});

const n = (value: number) => Math.round(value).toLocaleString('en-US');
const hours = (h: number) => `${h.toFixed(1)} h`;
const leftAmazon = amazonUrlFor(left, amazonTag);
const rightAmazon = amazonUrlFor(right, amazonTag);
const origin = Astro.site ?? site.url;
const path = '/guides/anker-solix-c1000-vs-c1000-gen-2/';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Anker SOLIX C1000 vs C1000 Gen 2',
  description:
    'Same Anker 1 kWh class, two generations. Gen 2 lists 2,000 W continuous. Neither peak is treated as inverter surge on this site. Estimated hours for CPAP; fridge starts stay unverified.',
  url: new URL(path, origin).href,
  publisher: { '@type': 'Organization', name: site.name },
  author: { '@type': 'Person', name: site.publisherName },
};
---

<Base
  title="Anker SOLIX C1000 vs C1000 Gen 2"
  description="Two generations of Anker's ~1 kWh station. Gen 2 lists 2,000 W continuous. Neither peak is used as inverter surge here. CPAP hours estimate; fridge starts stay unverified."
  canonicalPath={path}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-moss-700 dark:text-moss-300">Comparison</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
      Anker SOLIX C1000 vs C1000 Gen 2
    </h1>
    <p class="mt-6 max-w-[68ch] text-ink-600 dark:text-ink-300">
      Capacity is close (1,056 Wh vs 1,024 Wh). Gen 2 lists 2,000 W continuous against 1,800 W on
      the original. The peak numbers do not decide a fridge. C1000's 2,400 W is SurgePad
      (resistive). Gen 2's 3,000 W is labelled Peak Output, not inverter surge, so this catalog
      also leaves motor starts unverified.
    </p>
    <p class="mt-3 max-w-[68ch] text-sm text-ink-500 dark:text-ink-400">
      Specs were read from manufacturer pages ({left.verified_at} and {right.verified_at}). Hours
      are calculator estimates, not lab tests. Affiliate links may earn a commission.
    </p>

    <section class="mt-10">
      <h2 class="text-xl font-semibold tracking-tight">What actually changed</h2>
      <p class="mt-4 max-w-[68ch] text-ink-600 dark:text-ink-300">
        For a CPAP night, both clear the estimate. For a 12V camping fridge or a full-size fridge,
        neither has a surge row this site will check. Gen 2 is not a fridge-start upgrade. It is a
        higher continuous-watt listing, with no verified weight or warranty on the source page used
        here.
      </p>
    </section>

    <section class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        [
          { station: left, amazon: leftAmazon, badge: 'In stock here, 5-year warranty, 28.44 lb' },
          { station: right, amazon: rightAmazon, badge: '2,000 W continuous, peak still not surge' },
        ].map((col) => (
          <div class="rounded-[var(--radius-card)] border border-ink-200 bg-white p-5 dark:border-ink-800 dark:bg-ink-900">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-moss-700 dark:text-moss-300">
              {col.badge}
            </p>
            <img
              src={`/images/stations/${col.station.id}.webp`}
              alt={`${col.station.brand} ${col.station.model}`}
              width="160"
              height="120"
              class="mx-auto mt-4 h-24 w-32 object-contain"
            />
            <h3 class="mt-3 text-lg font-semibold">
              {col.station.brand} {col.station.model}
            </h3>
            <p class="tabular mt-1 text-sm text-ink-500">
              {n(col.station.capacity_wh)} Wh · {n(col.station.output_continuous_w)} W
            </p>
            <div class="mt-4 flex flex-col gap-2">
              {col.amazon ? (
                <a
                  href={col.amazon}
                  rel="sponsored nofollow noopener"
                  target="_blank"
                  class="press inline-flex justify-center rounded-[var(--radius-control)] bg-moss-700 px-4 py-2.5 text-sm font-semibold text-white hover:bg-moss-600"
                >
                  Check price on Amazon
                </a>
              ) : null}
              <a
                href={`/stations/${col.station.id}/`}
                class="press inline-flex justify-center rounded-[var(--radius-control)] border border-ink-200 px-4 py-2.5 text-sm font-medium hover:border-moss-500 dark:border-ink-700"
              >
                Full specs
              </a>
            </div>
          </div>
        ))
      }
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold tracking-tight">Manufacturer specs, side by side</h2>
      <div class="mt-4 overflow-x-auto rounded-[var(--radius-card)] border border-ink-200 dark:border-ink-800">
        <table class="w-full border-collapse bg-white text-left text-sm dark:bg-ink-900">
          <caption class="sr-only">C1000 versus C1000 Gen 2 specifications</caption>
          <thead>
            <tr class="border-b border-ink-200 dark:border-ink-800">
              <th scope="col" class="px-4 py-3 font-semibold">Spec</th>
              <th scope="col" class="px-4 py-3 font-semibold">C1000</th>
              <th scope="col" class="px-4 py-3 font-semibold">C1000 Gen 2</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-ink-100 dark:border-ink-800/60">
              <th scope="row" class="px-4 py-3 font-medium">Capacity</th>
              <td class="tabular px-4 py-3">{n(left.capacity_wh)} Wh</td>
              <td class="tabular px-4 py-3">{n(right.capacity_wh)} Wh</td>
            </tr>
            <tr class="border-b border-ink-100 dark:border-ink-800/60">
              <th scope="row" class="px-4 py-3 font-medium">Continuous output</th>
              <td class="tabular px-4 py-3">{n(left.output_continuous_w)} W</td>
              <td class="tabular px-4 py-3">{n(right.output_continuous_w)} W</td>
            </tr>
            <tr class="border-b border-ink-100 dark:border-ink-800/60">
              <th scope="row" class="px-4 py-3 font-medium">Peak</th>
              <td class="tabular px-4 py-3">{n(left.output_peak_w)} W boost (SurgePad)</td>
              <td class="tabular px-4 py-3">{n(right.output_peak_w)} W peak output, not surge</td>
            </tr>
            <tr class="border-b border-ink-100 dark:border-ink-800/60">
              <th scope="row" class="px-4 py-3 font-medium">Solar input max</th>
              <td class="tabular px-4 py-3">{n(left.solar_input_max_w ?? 0)} W</td>
              <td class="tabular px-4 py-3">{n(right.solar_input_max_w ?? 0)} W</td>
            </tr>
            <tr class="border-b border-ink-100 dark:border-ink-800/60">
              <th scope="row" class="px-4 py-3 font-medium">Weight</th>
              <td class="tabular px-4 py-3">{left.weight_lbs} lb</td>
              <td class="tabular px-4 py-3">Not on the source page</td>
            </tr>
            <tr>
              <th scope="row" class="px-4 py-3 font-medium">Warranty</th>
              <td class="tabular px-4 py-3">{left.warranty_years} years</td>
              <td class="tabular px-4 py-3">Not on the source page</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-ink-500">
        Sources:
        <a href={left.source_url} rel="nofollow noopener" class="underline" target="_blank">C1000</a>
        {' · '}
        <a href={right.source_url} rel="nofollow noopener" class="underline" target="_blank">C1000 Gen 2</a>
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold tracking-tight">Same calculator loads</h2>
      <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
        Hours use 85 percent usable capacity. Neither peak clears a compressor on this site. Open
        any row in the calculator to change watts or hours.
      </p>
      <div class="mt-4 overflow-x-auto rounded-[var(--radius-card)] border border-ink-200 dark:border-ink-800">
        <table class="w-full border-collapse bg-white text-left text-sm dark:bg-ink-900">
          <thead>
            <tr class="border-b border-ink-200 dark:border-ink-800">
              <th scope="col" class="px-4 py-3 font-semibold">Load</th>
              <th scope="col" class="px-4 py-3 font-semibold">C1000</th>
              <th scope="col" class="px-4 py-3 font-semibold">C1000 Gen 2</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr class="border-b border-ink-100 dark:border-ink-800/60">
                  <th scope="row" class="px-4 py-3 font-medium">
                    <a href={row.calcHref} class="text-moss-700 underline dark:text-moss-300">
                      {row.label}
                    </a>
                    <span class="mt-1 block text-xs font-normal text-ink-500">
                      Shop about {n(row.needWh)} Wh
                      {row.surgeW ? ` · start ${n(row.surgeW)} W` : ''}
                    </span>
                  </th>
                  <td class="px-4 py-3">
                    <span class="block font-semibold">{constraintLabel(row.left.bindingConstraint)}</span>
                    <span class="tabular text-xs text-ink-500">{hours(row.left.averageHours)} est.</span>
                  </td>
                  <td class="px-4 py-3">
                    <span class="block font-semibold">{constraintLabel(row.right.bindingConstraint)}</span>
                    <span class="tabular text-xs text-ink-500">{hours(row.right.averageHours)} est.</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <h2 class="mt-12 text-xl font-semibold tracking-tight">Who should buy which</h2>
    <ul class="mt-4 space-y-3 text-sm text-ink-600 dark:text-ink-300">
      <li class="max-w-[68ch]">
        <strong class="text-ink-900 dark:text-ink-100">C1000</strong> if you want a verified weight
        (28.44 lb), a 5-year warranty, and a listing marked in stock in this catalog. Fine for CPAP
        and charging. Not a fridge-start pick.
      </li>
      <li class="max-w-[68ch]">
        <strong class="text-ink-900 dark:text-ink-100">C1000 Gen 2</strong> if you want the 2,000 W
        continuous listing. It is not a motor-start upgrade over C1000. Weight and warranty are not
        on the source page used here.
      </li>
    </ul>
    <p class="mt-4 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
      For a fridge, use a station that publishes inverter surge, such as
      <a href="/guides/anker-solix-c1000-vs-bluetti-elite-100-v2/" class="text-moss-700 underline dark:text-moss-300">
        Elite 100 V2 versus C1000
      </a>
      or
      <a href="/guides/jackery-explorer-1000-v2-vs-anker-solix-c1000/" class="text-moss-700 underline dark:text-moss-300">
        Explorer 1000 v2 versus C1000
      </a>.
      Read
      <a href="/guides/surge-vs-boost/" class="text-moss-700 underline dark:text-moss-300">surge versus boost</a>.
    </p>

    <div class="mt-10">
      <Disclaimer medical electrical />
    </div>
  </article>
</Base>
