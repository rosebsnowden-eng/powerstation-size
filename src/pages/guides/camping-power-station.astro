---
/**
 * Camping decision page.
 *
 * Same URL as the original matching guide. Picks are verified models that
 * clear the camping-day load (12V fridge, laptop, light, phone) after
 * inverter loss and reserve, each with an Amazon button.
 */
import Base from '../../layouts/Base.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import db from '../../data/power-stations.json';
import { site } from '../../data/site.ts';
import { getScenario, analyzeScenario, scenarioQuery } from '../../data/scenarios.ts';
import { amazonUrlFor, isCurrent, toStationSpec } from '../../lib/catalog.ts';
import { runtimeFor } from '../../lib/calculate.ts';

const scenario = getScenario('camping-day');
if (!scenario) throw new Error('camping-day scenario missing');

const catalog = db.stations.filter(isCurrent);
const amazonTag = (db.meta as { amazon_tag?: string }).amazon_tag ?? '';
const analysis = analyzeScenario(scenario, catalog);
const { sizing, plan, match } = analysis;
const n = (value: number) => Math.round(value).toLocaleString('en-US');
const hours = (h: number) => `${h.toFixed(1)} h`;

const fullById = new Map(catalog.map((s) => [s.id, s]));
const eligible = match.eligible
  .map((entry) => fullById.get(entry.station.id))
  .filter((s): s is (typeof catalog)[number] => s !== undefined && s.availability !== 'out_of_stock');

const pickIds = [
  'jackery-explorer-1000-v2',
  'bluetti-elite-100-v2',
  'jackery-explorer-2000-v2',
] as const;
const picks = pickIds
  .map((id) => {
    const station = eligible.find((s) => s.id === id);
    if (!station) return null;
    const run = runtimeFor(toStationSpec(station), analysis.rows);
    return {
      station,
      amazon: amazonUrlFor(station, amazonTag),
      hours: run.averageHours,
      spareWh: station.capacity_wh - plan.recommendedWh,
    };
  })
  .filter((p): p is NonNullable<typeof p> => p !== null);

if (picks.length !== 3) {
  throw new Error(`Camping decision page expected 3 picks, got ${picks.length}`);
}

const labels = [
  'Best overall for this camping load',
  'Smallest nameplate that still clears it',
  'More spare for a second day',
] as const;
const why = [
  'Verified inverter surge, about 24 lb, and enough watt-hours for the 12V fridge plus laptop day after losses.',
  'The smallest verified pack in this catalog that still covers the estimated camping-day load.',
  'Same camping load with a larger spare. Heavier to carry; useful if the fridge runs longer than this example.',
] as const;

const origin = Astro.site ?? site.url;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Best portable power station for camping: size the day, then pick a station',
  description:
    'A 12V fridge, laptop, light, and phone sized with the same formulas as the calculator, and three verified stations that cover that camping-day load.',
  url: new URL('/guides/camping-power-station/', origin).href,
  publisher: { '@type': 'Organization', name: site.name },
};
---

<Base
  title="Best portable power station for camping"
  description="Size a camping day (12V fridge, laptop, light, phone) and three verified portable power stations that cover that load on paper, with Amazon links."
  canonicalPath="/guides/camping-power-station/"
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <article class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-moss-700 dark:text-moss-300">Camping</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">
      Best portable power station for camping: size the day, then pick
    </h1>
    <p class="mt-6 max-w-[68ch] text-ink-600 dark:text-ink-300">{scenario.lede}</p>
    <p class="mt-3 max-w-[68ch] text-sm text-ink-500 dark:text-ink-400">
      Device wattages are engineering ranges, not measurements. Station specs come from manufacturer
      pages. Hours below are calculated estimates, not lab runtimes. Affiliate links may earn a
      commission.
    </p>

    <section class="mt-10 rounded-[var(--radius-card)] border border-ink-200 bg-white p-5 dark:border-ink-800 dark:bg-ink-900">
      <h2 class="text-lg font-semibold tracking-tight">The camping-day load this page uses</h2>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">Daily energy</dt>
          <dd class="tabular mt-1 text-2xl font-semibold">{n(sizing.rawDailyWh)} Wh</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">Battery to shop</dt>
          <dd class="tabular mt-1 text-2xl font-semibold">{n(plan.recommendedWh)} Wh</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">Fridge startup</dt>
          <dd class="tabular mt-1 text-2xl font-semibold">{n(sizing.peakSurgeW)} W</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-500">All at once</dt>
          <dd class="tabular mt-1 text-2xl font-semibold">{n(sizing.simultaneousW)} W</dd>
        </div>
      </dl>
      <p class="mt-5 max-w-[68ch] border-t border-ink-100 pt-4 text-sm text-ink-600 dark:border-ink-800 dark:text-ink-300">
        {scenario.insight} A boost rating is not used to clear the fridge start.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold tracking-tight">Three stations that cover this camping-day estimate</h2>
      <p class="mt-3 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
        Each one clears capacity, continuous output, and a true inverter surge against the 12V fridge
        start in this example. Ranked for this load, not as a lab test.
      </p>

      <ol class="mt-8 space-y-8">
        {
          picks.map((pick, i) => (
            <li class="rounded-[var(--radius-card)] border border-ink-200 bg-white p-5 dark:border-ink-800 dark:bg-ink-900">
              <p class="text-xs font-semibold uppercase tracking-[0.14em] text-moss-700 dark:text-moss-300">
                #{i + 1} · {labels[i]}
              </p>
              <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-start">
                <img
                  src={`/images/stations/${pick.station.id}.webp`}
                  alt={`${pick.station.brand} ${pick.station.model}`}
                  width="160"
                  height="120"
                  class="h-28 w-36 shrink-0 object-contain"
                />
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-semibold tracking-tight">
                    {pick.station.brand} {pick.station.model}
                  </h3>
                  <p class="mt-2 max-w-[62ch] text-sm text-ink-600 dark:text-ink-300">{why[i]}</p>
                  <dl class="mt-4 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
                    <div>
                      <dt class="text-xs text-ink-500">Capacity</dt>
                      <dd class="tabular font-semibold">{n(pick.station.capacity_wh)} Wh</dd>
                    </div>
                    <div>
                      <dt class="text-xs text-ink-500">Continuous</dt>
                      <dd class="tabular font-semibold">{n(pick.station.output_continuous_w)} W</dd>
                    </div>
                    <div>
                      <dt class="text-xs text-ink-500">This load (est.)</dt>
                      <dd class="tabular font-semibold">{hours(pick.hours)}</dd>
                    </div>
                    <div>
                      <dt class="text-xs text-ink-500">Weight</dt>
                      <dd class="tabular font-semibold">
                        {pick.station.weight_lbs ? `${pick.station.weight_lbs} lb` : 'See spec page'}
                      </dd>
                    </div>
                  </dl>
                  <div class="mt-5 flex flex-wrap gap-3">
                    {pick.amazon ? (
                      <a
                        href={pick.amazon}
                        rel="sponsored nofollow noopener"
                        target="_blank"
                        class="press inline-flex rounded-[var(--radius-control)] bg-moss-700 px-5 py-3 text-sm font-semibold text-white hover:bg-moss-600"
                      >
                        Check price on Amazon
                      </a>
                    ) : null}
                    <a
                      href={`/stations/${pick.station.id}/`}
                      class="press inline-flex rounded-[var(--radius-control)] border border-ink-200 px-5 py-3 text-sm font-medium hover:border-moss-500 dark:border-ink-700"
                    >
                      Full specs
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-semibold tracking-tight">Side-by-side, same camping-day load</h2>
      <div class="mt-4 overflow-x-auto rounded-[var(--radius-card)] border border-ink-200 dark:border-ink-800">
        <table class="w-full border-collapse bg-white text-left text-sm dark:bg-ink-900">
          <caption class="sr-only">Camping pick comparison</caption>
          <thead>
            <tr class="border-b border-ink-200 dark:border-ink-800">
              <th scope="col" class="px-4 py-3 font-semibold">Station</th>
              <th scope="col" class="px-4 py-3 font-semibold">Wh</th>
              <th scope="col" class="px-4 py-3 font-semibold">This load</th>
              <th scope="col" class="px-4 py-3 font-semibold">Spare</th>
              <th scope="col" class="px-4 py-3 font-semibold">Weight</th>
            </tr>
          </thead>
          <tbody>
            {
              picks.map((pick) => (
                <tr class="border-b border-ink-100 dark:border-ink-800/60">
                  <th scope="row" class="px-4 py-3 font-medium">
                    {pick.station.brand} {pick.station.model}
                  </th>
                  <td class="tabular px-4 py-3">{n(pick.station.capacity_wh)}</td>
                  <td class="tabular px-4 py-3">{hours(pick.hours)}</td>
                  <td class="tabular px-4 py-3">{n(pick.spareWh)} Wh</td>
                  <td class="tabular px-4 py-3">
                    {pick.station.weight_lbs ? `${pick.station.weight_lbs} lb` : 'See spec page'}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <h2 class="mt-12 text-xl font-semibold tracking-tight">What this camping day includes</h2>
    <ul class="mt-4 space-y-3 text-sm text-ink-600 dark:text-ink-300">
      {
        analysis.rows.map((row) => (
          <li class="max-w-[68ch]">
            {row.label}: {row.watts} W × {row.hours} h
            {row.dutyCycle < 1 ? ` at ${Math.round(row.dutyCycle * 100)}% duty` : ''}
            {row.surgeWatts ? ` · startup about ${n(row.surgeWatts)} W` : ''}
          </li>
        ))
      }
    </ul>
    <p class="mt-4 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
      {scenario.trim}
    </p>

    <p class="mt-6 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
      C1000 is not in this camping three because its 2,400 W peak is SurgePad, not inverter surge.
      That comparison is written out on
      <a href="/guides/anker-solix-c1000-vs-bluetti-elite-100-v2/" class="text-moss-700 underline dark:text-moss-300">
        C1000 vs Elite 100 V2
      </a>.
      Explorer 1000 v2 versus Elite 100 V2 (both true surge) is on
      <a href="/guides/jackery-explorer-1000-v2-vs-bluetti-elite-100-v2/" class="text-moss-700 underline dark:text-moss-300">
        this comparison
      </a>
      . Same-brand spare versus weight is
      <a href="/guides/jackery-explorer-1000-v2-vs-2000-v2/" class="text-moss-700 underline dark:text-moss-300">
        1000 v2 vs 2000 v2
      </a>.
    </p>

    <h2 class="mt-10 text-xl font-semibold tracking-tight">Open the same load in the calculator</h2>
    <p class="mt-4 max-w-[68ch] text-sm text-ink-600 dark:text-ink-300">
      {match.eligible.length} verified models cover this camping-day estimate on paper. Change hours
      or drop the laptop in the
      <a
        href={`/calculator/#calculator?load=${encodeURIComponent(scenarioQuery(scenario))}&days=1&sun=5&station=${picks[0].station.id}`}
        class="text-moss-700 underline dark:text-moss-300"
      >
        calculator
      </a>
      , or read the worked
      <a href="/scenarios/camping-day/" class="text-moss-700 underline dark:text-moss-300">camping-day scenario</a>.
    </p>

    <div class="mt-10">
      <Disclaimer />
    </div>
  </article>
</Base>
