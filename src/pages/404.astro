---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist.">
  <section class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="tabular text-sm text-ink-500">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">That page does not exist</h1>
    <p class="mt-4 text-ink-600 dark:text-ink-300">
      The link may be out of date, or the page may not have been written yet.
    </p>
    <a
      href="/calculator/"
      class="press mt-8 inline-block rounded-[var(--radius-control)] bg-moss-700 px-5 py-3 text-sm font-semibold text-white hover:bg-moss-600"
    >
      Go to the calculator
    </a>
  </section>
</Base>
